  "private": true,
  "homepage": "https://github.com/LL33ch/shadcn-start",
  "repository": {
    "type": "git",
    "url": "https://github.com/LL33ch/shadcn-start.git"
  },
  "registry": {
    "namespace": "@shadcn-start",
    "url": "https://raw.githubusercontent.com/LL33ch/shadcn-start/main/public/r"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/gen-docs.mjs",
    "registry": "node scripts/build-registry.mjs && shadcn build"
  },
  "dependencies": {
